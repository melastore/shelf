<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<uses-permission android:name="android.permission.USE_BIOMETRIC" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<!--
		Not dataSync: that type is capped at a few hours a day and is stopped from under you, and this
		service has to stay up for as long as a folder is exposed, which the owner decides.
	-->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />
	<!--
		For the re-hide timer. Inexact alarms land up to three quarters of the interval late, so a
		five minute setting ran close to nine. Both are granted at install, nothing is asked.
	-->
	<uses-permission android:name="android.permission.USE_EXACT_ALARM" />
	<uses-permission
		android:name="android.permission.SCHEDULE_EXACT_ALARM"
		android:maxSdkVersion="32" />

	<!--
		Optional, and never requested unless the user asks for stronger hiding from inside the vault.
		It allows an instant move into a dedicated hidden directory on shared storage. Declaring it
		does put "All files access" in the app's permission list, which is a tell; without it Shelf
		falls back to renaming folders in place.
	-->
	<uses-permission
		android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
		tools:ignore="ScopedStorage" />

	<application
		android:allowBackup="false"
		android:dataExtractionRules="@xml/data_extraction_rules"
		android:fullBackupContent="false"
		android:icon="@mipmap/ic_launcher_shelf"
		android:label="@string/launcher_shelf"
		android:roundIcon="@mipmap/ic_launcher_shelf"
		android:supportsRtl="true"
		android:theme="@style/Theme.Shelf">

		<!--
			Not exported: every launcher entry is an alias, and an alias reaches its target activity
			whatever the target's own export state is. Exporting it as well only offers other apps a
			component to start directly.
		-->
		<!--
			Handles rotation itself. The player turns the screen to suit the video, and a recreated
			activity would take the decrypted media in RAM down with it and drop the owner back at
			the lock screen mid-video.
		-->
		<activity
			android:name=".ui.MainActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
			android:exported="false" />
		<receiver android:name=".ui.QuickLockReceiver" android:exported="false" />

		<!--
			Exported because only the system sends BOOT_COMPLETED, and a receiver for it cannot be
			reached any other way. It reposts the emergency-hide notification and nothing else.
		-->
		<receiver android:name=".ui.BootReceiver" android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.BOOT_COMPLETED" />
			</intent-filter>
		</receiver>
		<!--
			Holds the screen-off listener and runs the hide. Screen-off is registered-only, so nothing
			in the manifest can catch it, and a service that asks to become foreground from a receiver
			is refused on recent releases.
		-->
		<service
			android:name=".ui.QuickLockService"
			android:exported="false"
			android:foregroundServiceType="specialUse">
			<property
				android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
				android:value="Re-hides folders the owner left exposed when the screen turns off" />
		</service>

		<!-- Enabled by default: the app wears no disguise until one is chosen. -->
		<activity-alias
			android:name=".ShelfLauncher"
			android:enabled="true"
			android:exported="true"
			android:icon="@mipmap/ic_launcher_shelf"
			android:label="@string/launcher_shelf"
			android:roundIcon="@mipmap/ic_launcher_shelf"
			android:targetActivity=".ui.MainActivity">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>

		<activity-alias
			android:name=".HabitLauncher"
			android:enabled="false"
			android:exported="true"
			android:icon="@mipmap/ic_launcher"
			android:label="@string/launcher_habits"
			android:roundIcon="@mipmap/ic_launcher_round"
			android:targetActivity=".ui.MainActivity">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>

		<activity-alias
			android:name=".CalendarLauncher"
			android:enabled="false"
			android:exported="true"
			android:icon="@mipmap/ic_launcher_calendar"
			android:label="@string/launcher_calendar"
			android:roundIcon="@mipmap/ic_launcher_calendar"
			android:targetActivity=".ui.MainActivity">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>

		<activity-alias
			android:name=".CalculatorLauncher"
			android:enabled="false"
			android:exported="true"
			android:icon="@mipmap/ic_launcher_calculator"
			android:label="@string/launcher_calculator"
			android:roundIcon="@mipmap/ic_launcher_calculator"
			android:targetActivity=".ui.MainActivity">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>
	</application>
</manifest>
